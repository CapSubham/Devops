#!/bin/bash
# ==============================================================================
# Native SAP Kernel Maintenance Execution, Upgrade & Rollback Script
#
# Developed and maintained by : Subham Dubey
# Contact for issues/feedback : Subham Dubey
#
# WARNING: This script stops the SAP system, replaces kernel, and restarts.
#          Execute only during approved maintenance windows.
# ==============================================================================


set -e

# ------------------------------------------------------------------------------
# Global Variables & Color Codes
# ------------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

OLD_KERNEL_RELEASE=""
OLD_KERNEL_PATCH=""
NEW_KERNEL_RELEASE=""
NEW_KERNEL_PATCH=""
ROLLBACK_TRIGGERED=0

# ------------------------------------------------------------------------------
# Step 1: Environment & Permission Validation
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 1: Running Environment Checks ---${NC}"

if [ -z "$SAPSYSTEMNAME" ]; then
    echo -e "${RED}ERROR: SAPSYSTEMNAME is not set. Execute this script in a clean <sidadm> login shell.${NC}"
    exit 1
fi

SID="$SAPSYSTEMNAME"
SID_LOWER=$(echo "$SID" | tr '[:upper:]' '[:lower:]')
SIDADM="${SID_LOWER}adm"

if [ "$(whoami)" != "$SIDADM" ]; then
    echo -e "${RED}ERROR: This script must be run as $SIDADM (current user: $(whoami)).${NC}"
    exit 1
fi

if ! command -v sapcontrol > /dev/null 2>&1; then
    echo -e "${RED}ERROR: 'sapcontrol' binary not found in PATH. Ensure you are using 'su - $SIDADM' with profile loaded.${NC}"
    exit 1
fi

BASE_DIR="/usr/sap/maintenance_checks/$SID"
KERNEL_DIR="/sapmnt/$SID/exe/uc/linuxx86_64"

if [ ! -d "$KERNEL_DIR" ]; then
    echo -e "${RED}ERROR: Source kernel directory $KERNEL_DIR does not exist or is inaccessible.${NC}"
    exit 1
fi

if [ ! -d "$BASE_DIR" ]; then
    mkdir -p "$BASE_DIR" 2>/dev/null || {
        echo -e "${RED}ERROR: Cannot create $BASE_DIR. Permission denied.${NC}"
        exit 1
    }
fi

if [ ! -w "$BASE_DIR" ]; then
    echo -e "${RED}ERROR: Directory $BASE_DIR is not writable by $(whoami).${NC}"
    exit 1
fi

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
RUN_DIR="$BASE_DIR/run_$TIMESTAMP"

echo -e "${GREEN}Environment validation passed.${NC}"

# ------------------------------------------------------------------------------
# Step 2: Accept & Validate Extracted Kernel Source Path
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 2: Kernel Source Input & Validation ---${NC}"

echo ""
echo "========================================================================"
echo "  Enter the FULL path where the NEW kernel files have been extracted."
echo "  Example: /sapcd/SAP_PATCHES/kernel_900_staging"
echo "========================================================================"
echo ""
read -rp "Extracted Kernel Path: " NEW_KERNEL_SRC

# Strip trailing slash if present
NEW_KERNEL_SRC="${NEW_KERNEL_SRC%/}"

if [ -z "$NEW_KERNEL_SRC" ]; then
    echo -e "${RED}ERROR: No path provided. Aborting.${NC}"
    exit 1
fi

if [ ! -d "$NEW_KERNEL_SRC" ]; then
    echo -e "${RED}ERROR: Directory '$NEW_KERNEL_SRC' does not exist.${NC}"
    exit 1
fi

# Validate critical kernel binaries exist in the source
REQUIRED_FILES=("disp+work" "dbhdbslib.so" "sapstartsrv" "sapstart" "tp" "R3trans" "icman" "gwrd" "msg_server")
MISSING_FILES=()

for reqfile in "${REQUIRED_FILES[@]}"; do
    if [ ! -f "$NEW_KERNEL_SRC/$reqfile" ]; then
        MISSING_FILES+=("$reqfile")
    fi
done

if [ ${#MISSING_FILES[@]} -gt 0 ]; then
    echo -e "${RED}ERROR: The following critical kernel files are MISSING from $NEW_KERNEL_SRC:${NC}"
    for mf in "${MISSING_FILES[@]}"; do
        echo "       - $mf"
    done
    echo -e "${RED}Ensure both SAPEXE and SAPEXEDB SAR archives were extracted to this path.${NC}"
    exit 1
fi

echo -e "${GREEN}All critical kernel files found in: $NEW_KERNEL_SRC${NC}"

# Capture NEW kernel version from staged binary
echo "Reading version from staged disp+work..."
set +e
NEW_VERSION_OUTPUT=$("$NEW_KERNEL_SRC/disp+work" -V 2>&1)
set -e

NEW_KERNEL_RELEASE=$(echo "$NEW_VERSION_OUTPUT" | grep -i "kernel release" | head -1 | awk '{print $NF}')
NEW_KERNEL_PATCH=$(echo "$NEW_VERSION_OUTPUT" | grep -i "patch number" | head -1 | awk '{print $NF}')

if [ -z "$NEW_KERNEL_RELEASE" ]; then
    echo -e "${YELLOW}WARNING: Could not read version from staged disp+work (shared library issue). Will validate after deployment.${NC}"
    NEW_KERNEL_RELEASE="PENDING"
    NEW_KERNEL_PATCH="PENDING"
else
    echo -e "${GREEN}New kernel: Release $NEW_KERNEL_RELEASE | Patch $NEW_KERNEL_PATCH${NC}"
fi

# Capture OLD (current) kernel version
echo "Reading current kernel version..."
set +e
OLD_VERSION_OUTPUT=$("$KERNEL_DIR/disp+work" -V 2>&1)
set -e

OLD_KERNEL_RELEASE=$(echo "$OLD_VERSION_OUTPUT" | grep -i "kernel release" | head -1 | awk '{print $NF}')
OLD_KERNEL_PATCH=$(echo "$OLD_VERSION_OUTPUT" | grep -i "patch number" | head -1 | awk '{print $NF}')

if [ -z "$OLD_KERNEL_RELEASE" ]; then
    echo -e "${RED}ERROR: Cannot determine current kernel version. Kernel directory may be corrupt.${NC}"
    exit 1
fi

echo -e "${GREEN}Current kernel: Release $OLD_KERNEL_RELEASE | Patch $OLD_KERNEL_PATCH${NC}"

# Summary confirmation
echo ""
echo "========================================================================"
echo -e "  ${YELLOW}KERNEL UPGRADE SUMMARY${NC}"
echo "========================================================================"
echo -e "  SID             : $SID"
echo -e "  Current Kernel  : Release ${OLD_KERNEL_RELEASE} | Patch ${OLD_KERNEL_PATCH}"
echo -e "  Target Kernel   : Release ${NEW_KERNEL_RELEASE} | Patch ${NEW_KERNEL_PATCH}"
echo -e "  Source Path      : $NEW_KERNEL_SRC"
echo -e "  Target Path      : $KERNEL_DIR"
echo -e "  Backup Location  : $RUN_DIR"
echo "========================================================================"
echo ""
read -rp "Proceed with kernel upgrade? (yes/no): " CONFIRM

if [[ "$CONFIRM" != "yes" ]]; then
    echo "Upgrade aborted by user."
    exit 0
fi

# ------------------------------------------------------------------------------
# Step 3: Dynamic Disk Space Validation
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 3: Checking Dynamic Disk Space Requirements ---${NC}"

check_space_for_backup() {
    local target_dir=$1
    local source_dir=$2

    local avail_mb=$(df -PB 1M "$target_dir" | awk 'NR==2 {print $4}')
    local source_size_mb=$(du -sm "$source_dir" | awk '{print $1}')
    local required_mb=$((source_size_mb + 10240))
    local avail_gb=$((avail_mb / 1024))
    local req_gb=$((required_mb / 1024))

    if [ "$avail_mb" -lt "$required_mb" ]; then
        echo -e "${RED}ERROR: Insufficient space in $target_dir to safely backup kernel!${NC}"
        echo "       Available: ${avail_gb}GB | Required: ${req_gb}GB"
        exit 1
    else
        echo -e "${GREEN}OK: $target_dir has ${avail_gb}GB available (Requires ${req_gb}GB).${NC}"
    fi
}

check_space_for_backup "$BASE_DIR" "$KERNEL_DIR"

mkdir -p "$RUN_DIR"
echo "Execution directory created: $RUN_DIR"

# Save version info to run directory for audit
echo "OLD_KERNEL_RELEASE=$OLD_KERNEL_RELEASE" > "$RUN_DIR/version_info.txt"
echo "OLD_KERNEL_PATCH=$OLD_KERNEL_PATCH" >> "$RUN_DIR/version_info.txt"
echo "NEW_KERNEL_RELEASE=$NEW_KERNEL_RELEASE" >> "$RUN_DIR/version_info.txt"
echo "NEW_KERNEL_PATCH=$NEW_KERNEL_PATCH" >> "$RUN_DIR/version_info.txt"
echo "NEW_KERNEL_SRC=$NEW_KERNEL_SRC" >> "$RUN_DIR/version_info.txt"
echo "TIMESTAMP=$TIMESTAMP" >> "$RUN_DIR/version_info.txt"

# ------------------------------------------------------------------------------
# Step 4: Pre-Shutdown System Diagnostics
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 4: Capturing Pre-Shutdown System Logs ---${NC}"

{
    echo "=== TIMESTAMP ==="
    date
    echo -e "\n=== MEMORY UTILIZATION ==="
    free -m
    echo -e "\n=== CPU UTILIZATION ==="
    top -b -n 1 | head -n 20
    echo -e "\n=== DISK SPACE (df -h) ==="
    df -h
} > "$RUN_DIR/resource.txt"

ps -ef > "$RUN_DIR/all_process"
ps -ef | grep -E "(dw|ms|enq|disp|igswd|gwrd|sapstart|sapcontrol|_sys_)" | grep -v grep > "$RUN_DIR/sap_process" || true
disp+work -V > "$RUN_DIR/old_kernel_version.txt" 2>&1 || true

echo -e "${GREEN}Diagnostics saved to $RUN_DIR${NC}"

# ------------------------------------------------------------------------------
# Step 5: Dynamic Landscape Mapping & Parallel Shutdown
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 5: Mapping SAP Landscape & Executing Parallel Shutdown ---${NC}"

LOCAL_INST=$(ls -d /usr/sap/"$SID"/*[0-9][0-9] 2>/dev/null | grep -oE "[0-9]{2}$" | head -n 1)
if [ -z "$LOCAL_INST" ]; then
    echo -e "${YELLOW}WARNING: Could not detect local instance. Falling back to instance 00.${NC}"
    LOCAL_INST="00"
fi

APP_INSTANCES=()
CS_INSTANCES=()

while IFS=',' read -r host inst http https prio features status; do
    host=$(echo "$host" | tr -d ' ')
    inst=$(echo "$inst" | tr -d ' ')
    features=$(echo "$features" | tr -d ' ')

    if [[ ! "$inst" =~ ^[0-9]+$ ]]; then
        continue
    fi

    if [[ "$features" == *"ASCS"* ]] || [[ "$features" == *"SCS"* ]]; then
        CS_INSTANCES+=("$inst:$host:$features")
    else
        APP_INSTANCES+=("$inst:$host:$features")
    fi
done < <(sapcontrol -nr "$LOCAL_INST" -function GetSystemInstanceList | grep -E "^[a-zA-Z0-9._-]+,\s*[0-9]+,")

if [ ${#APP_INSTANCES[@]} -eq 0 ] && [ ${#CS_INSTANCES[@]} -eq 0 ]; then
    echo -e "${RED}ERROR: No valid SAP instances detected. Aborting.${NC}"
    exit 1
fi

echo "Detected SAP Landscape:"
printf "%-10s %-20s %-35s\n" "INST_NR" "HOST" "FEATURES"
printf "%-10s %-20s %-35s\n" "-------" "----" "--------"
for entry in "${APP_INSTANCES[@]}" "${CS_INSTANCES[@]}"; do
    IFS=':' read -r nr host feat <<< "$entry"
    printf "%-10s %-20s %-35s\n" "$nr" "$host" "$feat"
done

# Stop Application Servers first (parallel broadcast)
echo "Broadcasting Stop signal to all Application Servers..."
for entry in "${APP_INSTANCES[@]}"; do
    IFS=':' read -r nr host feat <<< "$entry"
    echo "  -> Triggering Stop on instance $nr ($feat) on host $host..."
    sapcontrol -host "$host" -nr "$nr" -function Stop || {
        echo -e "${YELLOW}WARNING: Stop command failed for $host (Instance $nr).${NC}"
    }
done

# Wait for application servers to fully stop
echo "Waiting for Application Servers to halt..."
for entry in "${APP_INSTANCES[@]}"; do
    IFS=':' read -r nr host feat <<< "$entry"
    echo "  -> Verifying shutdown for instance $nr on $host..."

    set +e
    sapcontrol -host "$host" -nr "$nr" -function WaitforStopped 600 10
    STOP_STATUS=$?
    set -e

    if [ $STOP_STATUS -ne 0 ]; then
        echo -e "${RED}ERROR: Instance $nr on $host failed to stop within 10 minutes!${NC}"
        exit 1
    else
        echo -e "     ${GREEN}Instance $nr on $host stopped successfully.${NC}"
    fi
done

# Stop Central Services LAST
echo "Stopping Central Services..."
for entry in "${CS_INSTANCES[@]}"; do
    IFS=':' read -r nr host feat <<< "$entry"
    echo "  -> Stopping Central Services $nr ($feat) on host $host..."
    sapcontrol -host "$host" -nr "$nr" -function Stop
    
    set +e
    sapcontrol -host "$host" -nr "$nr" -function WaitforStopped 600 10
    CS_STOP_STATUS=$?
    set -e

    if [ $CS_STOP_STATUS -ne 0 ]; then
        echo -e "${RED}ERROR: Central Services $nr on $host failed to stop!${NC}"
        exit 1
    fi
done

echo -e "${GREEN}All SAP instances stopped gracefully.${NC}"

# ------------------------------------------------------------------------------
# Step 6: Distributed IPC Cleanup
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 6: Executing cleanipc Across Landscape ---${NC}"
LOCAL_HOST=$(hostname -s | tr '[:upper:]' '[:lower:]')
ALL_INSTS=("${APP_INSTANCES[@]}" "${CS_INSTANCES[@]}")

for entry in "${ALL_INSTS[@]}"; do
    IFS=':' read -r nr host feat <<< "$entry"
    TARGET_HOST=$(echo "$host" | cut -d'.' -f1 | tr '[:upper:]' '[:lower:]')

    echo "Cleaning IPC for instance $nr on $host..."

    if [[ "$TARGET_HOST" == "$LOCAL_HOST" ]] || [[ "$TARGET_HOST" == "localhost" ]]; then
        cleanipc "$nr" remove > /dev/null 2>&1 || true
        sleep 2
        cleanipc "$nr" remove > /dev/null 2>&1 || true
    else
        ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" \
            "cleanipc $nr remove; sleep 2; cleanipc $nr remove" > /dev/null 2>&1 || {
            echo -e "${YELLOW}WARNING: SSH cleanipc failed on $host.${NC}"
        }
    fi
done

echo -e "${GREEN}IPC cleanup complete.${NC}"

# ------------------------------------------------------------------------------
# Step 7: Atomic Kernel Backup
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 7: Performing Kernel Backup ---${NC}"

TAR_FILE="$RUN_DIR/kernel_${SID}_${TIMESTAMP}.tar.gz"
echo "Creating compressed kernel archive: $TAR_FILE"

tar -czf "$TAR_FILE" -C "$KERNEL_DIR" . || {
    echo -e "${RED}ERROR: Tar compression failed. Removing corrupt archive.${NC}"
    rm -f "$TAR_FILE"
    exit 1
}

# Validate archive integrity
tar -tzf "$TAR_FILE" > /dev/null 2>&1 || {
    echo -e "${RED}ERROR: Backup archive validation failed. Archive is corrupt!${NC}"
    rm -f "$TAR_FILE"
    exit 1
}

BACKUP_SIZE=$(du -sh "$TAR_FILE" | awk '{print $1}')
echo -e "${GREEN}Backup verified successfully: $TAR_FILE ($BACKUP_SIZE)${NC}"

# ------------------------------------------------------------------------------
# Step 8: Stop sapstartsrv Before Kernel Replacement
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 8: Stopping sapstartsrv Across Landscape ---${NC}"

for entry in "${ALL_INSTS[@]}"; do
    IFS=':' read -r nr host feat <<< "$entry"
    TARGET_HOST=$(echo "$host" | cut -d'.' -f1 | tr '[:upper:]' '[:lower:]')

    echo "  -> Stopping sapstartsrv for instance $nr on $host..."

    if [[ "$TARGET_HOST" == "$LOCAL_HOST" ]] || [[ "$TARGET_HOST" == "localhost" ]]; then
        set +e
        sapcontrol -nr "$nr" -function StopService
        set -e
        sleep 3
    else
        ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" \
            "sapcontrol -nr $nr -function StopService" > /dev/null 2>&1 || {
            echo -e "${YELLOW}WARNING: StopService failed on $host instance $nr.${NC}"
        }
    fi
done

# Verify no sapstartsrv processes remain locally
sleep 5
REMAINING_SRV=$(ps -ef | grep sapstartsrv | grep -i "$SID" | grep -v grep | wc -l)
if [ "$REMAINING_SRV" -gt 0 ]; then
    echo -e "${YELLOW}WARNING: $REMAINING_SRV sapstartsrv process(es) still running. Force killing...${NC}"
    ps -ef | grep sapstartsrv | grep -i "$SID" | grep -v grep | awk '{print $2}' | xargs kill -9 2>/dev/null || true
    sleep 3
fi

echo -e "${GREEN}All sapstartsrv processes stopped.${NC}"

# ------------------------------------------------------------------------------
# Step 9: Kernel File Replacement
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 9: Deploying New Kernel Files ---${NC}"

echo "Copying new kernel files from $NEW_KERNEL_SRC to $KERNEL_DIR..."
echo "Target: $KERNEL_DIR"

# Count files before copy
OLD_FILE_COUNT=$(ls -1 "$KERNEL_DIR" | wc -l)
NEW_FILE_COUNT=$(ls -1 "$NEW_KERNEL_SRC" | wc -l)

echo "  Current kernel file count : $OLD_FILE_COUNT"
echo "  New kernel file count     : $NEW_FILE_COUNT"

# Perform the copy — preserve timestamps, recursive for subdirectories
cp -rp "$NEW_KERNEL_SRC"/* "$KERNEL_DIR"/ || {
    echo -e "${RED}CRITICAL ERROR: File copy failed mid-execution!${NC}"
    echo -e "${RED}Kernel directory may be in inconsistent state. Initiating emergency rollback...${NC}"
    ROLLBACK_TRIGGERED=1
}

if [ "$ROLLBACK_TRIGGERED" -eq 0 ]; then
    # Fix ownership and permissions
    chown -R "$SIDADM":sapsys "$KERNEL_DIR"/*
    chmod 755 "$KERNEL_DIR"/disp+work
    chmod 755 "$KERNEL_DIR"/sapstartsrv
    chmod 755 "$KERNEL_DIR"/sapstart
    chmod 755 "$KERNEL_DIR"/R3trans
    chmod 755 "$KERNEL_DIR"/tp
    chmod 755 "$KERNEL_DIR"/icman
    chmod 755 "$KERNEL_DIR"/gwrd
    chmod 755 "$KERNEL_DIR"/msg_server

    # Validate critical files were replaced (check date matches new source)
    NEW_DISP_DATE=$(stat -c %Y "$NEW_KERNEL_SRC/disp+work")
    CUR_DISP_DATE=$(stat -c %Y "$KERNEL_DIR/disp+work")

    if [ "$NEW_DISP_DATE" -eq "$CUR_DISP_DATE" ]; then
        echo -e "${GREEN}Kernel files deployed successfully. File timestamps verified.${NC}"
    else
        echo -e "${RED}ERROR: disp+work timestamp mismatch after copy! Possible copy failure.${NC}"
        ROLLBACK_TRIGGERED=1
    fi
fi

# ------------------------------------------------------------------------------
# Step 10: Restart sapstartsrv & SAP System
# ------------------------------------------------------------------------------
if [ "$ROLLBACK_TRIGGERED" -eq 0 ]; then
    echo -e "${CYAN}--- Step 10: Starting sapstartsrv & SAP Instances ---${NC}"

    # Start sapstartsrv on all local instances first
    for entry in "${ALL_INSTS[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        TARGET_HOST=$(echo "$host" | cut -d'.' -f1 | tr '[:upper:]' '[:lower:]')

        if [[ "$TARGET_HOST" == "$LOCAL_HOST" ]] || [[ "$TARGET_HOST" == "localhost" ]]; then
            PROFILE_PATH="/usr/sap/$SID/SYS/profile/${SID}_${feat//|/_}_${host}"

            # Find the correct instance profile
            INST_PROFILE=$(ls /usr/sap/"$SID"/SYS/profile/"${SID}"_*"${nr}"_* 2>/dev/null | head -1)

            if [ -z "$INST_PROFILE" ]; then
                echo -e "${YELLOW}WARNING: Could not find instance profile for instance $nr. Trying pattern match...${NC}"
                INST_PROFILE=$(find /usr/sap/"$SID"/SYS/profile/ -name "${SID}_*${nr}*" -not -name "*.bak" | head -1)
            fi

            if [ -n "$INST_PROFILE" ]; then
                echo "  -> Starting sapstartsrv for instance $nr with profile: $INST_PROFILE"
                "$KERNEL_DIR"/sapstartsrv pf="$INST_PROFILE" -D -u "$SIDADM"
                sleep 5
            else
                echo -e "${RED}ERROR: No instance profile found for instance $nr. Cannot start sapstartsrv.${NC}"
                ROLLBACK_TRIGGERED=1
                break
            fi
        else
            echo "  -> Starting sapstartsrv on remote host $host for instance $nr..."
            ssh -o BatchMode=yes -o ConnectTimeout=10 "$host" \
                "$KERNEL_DIR/sapstartsrv pf=/usr/sap/$SID/SYS/profile/${SID}_*${nr}* -D -u $SIDADM" 2>/dev/null || {
                echo -e "${YELLOW}WARNING: Remote sapstartsrv start failed on $host.${NC}"
            }
            sleep 5
        fi
    done
fi

# Start SAP instances (Central Services FIRST, then Application Servers)
if [ "$ROLLBACK_TRIGGERED" -eq 0 ]; then
    echo "Starting Central Services first..."
    for entry in "${CS_INSTANCES[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        echo "  -> Starting Central Services $nr ($feat) on $host..."
        
        set +e
        sapcontrol -host "$host" -nr "$nr" -function Start
        sapcontrol -host "$host" -nr "$nr" -function WaitforStarted 300 10
        CS_START_STATUS=$?
        set -e

        if [ $CS_START_STATUS -ne 0 ]; then
            echo -e "${RED}ERROR: Central Services $nr failed to start!${NC}"
            ROLLBACK_TRIGGERED=1
            break
        else
            echo -e "     ${GREEN}Central Services $nr started successfully.${NC}"
        fi
    done
fi

if [ "$ROLLBACK_TRIGGERED" -eq 0 ]; then
    echo "Starting Application Servers..."
    for entry in "${APP_INSTANCES[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        echo "  -> Starting instance $nr ($feat) on $host..."

        set +e
        sapcontrol -host "$host" -nr "$nr" -function Start
        sapcontrol -host "$host" -nr "$nr" -function WaitforStarted 600 10
        APP_START_STATUS=$?
        set -e

        if [ $APP_START_STATUS -ne 0 ]; then
            echo -e "${RED}ERROR: Instance $nr on $host failed to start!${NC}"
            ROLLBACK_TRIGGERED=1
            break
        else
            echo -e "     ${GREEN}Instance $nr on $host started successfully.${NC}"
        fi
    done
fi

# ------------------------------------------------------------------------------
# Step 11: Post-Upgrade Validation
# ------------------------------------------------------------------------------
if [ "$ROLLBACK_TRIGGERED" -eq 0 ]; then
    echo -e "${CYAN}--- Step 11: Post-Upgrade Kernel Version Validation ---${NC}"

    sleep 10  # Allow work processes to fully initialize

    # Read deployed kernel version
    set +e
    POST_VERSION_OUTPUT=$("$KERNEL_DIR/disp+work" -V 2>&1)
    set -e

    POST_KERNEL_RELEASE=$(echo "$POST_VERSION_OUTPUT" | grep -i "kernel release" | head -1 | awk '{print $NF}')
    POST_KERNEL_PATCH=$(echo "$POST_VERSION_OUTPUT" | grep -i "patch number" | head -1 | awk '{print $NF}')
    POST_COMPILE_TIME=$(echo "$POST_VERSION_OUTPUT" | grep -i "compile time" | head -1 | sed 's/.*compile time\s*//')

    # Save new version info
    disp+work -V > "$RUN_DIR/new_kernel_version.txt" 2>&1 || true

    # Validate the version actually changed
    UPGRADE_SUCCESS=0

    if [ -z "$POST_KERNEL_RELEASE" ] || [ -z "$POST_KERNEL_PATCH" ]; then
        echo -e "${RED}ERROR: Cannot determine post-upgrade kernel version!${NC}"
        ROLLBACK_TRIGGERED=1
    elif [ "$POST_KERNEL_PATCH" = "$OLD_KERNEL_PATCH" ] && [ "$POST_KERNEL_RELEASE" = "$OLD_KERNEL_RELEASE" ]; then
        echo -e "${RED}ERROR: Kernel version unchanged after upgrade!${NC}"
        echo "  Expected change from Patch $OLD_KERNEL_PATCH to a newer patch."
        ROLLBACK_TRIGGERED=1
    else
        UPGRADE_SUCCESS=1
    fi

    if [ "$UPGRADE_SUCCESS" -eq 1 ]; then
        # Validate work processes are running
        set +e
        WP_CHECK=$(sapcontrol -nr "$LOCAL_INST" -function GetProcessList 2>&1)
        WP_GREEN=$(echo "$WP_CHECK" | grep -c "GREEN")
        WP_TOTAL=$(echo "$WP_CHECK" | grep -cE "GREEN|YELLOW|RED|GRAY")
        set -e

        echo ""
        echo -e "${GREEN}========================================================================${NC}"
        echo -e "${GREEN}           SAP KERNEL UPGRADE COMPLETED SUCCESSFULLY                    ${NC}"
        echo -e "${GREEN}========================================================================${NC}"
        echo ""
        echo -e "  System SID        : $SID"
        echo -e "  Previous Kernel   : Release ${RED}${OLD_KERNEL_RELEASE}${NC} | Patch ${RED}${OLD_KERNEL_PATCH}${NC}"
        echo -e "  Current Kernel    : Release ${GREEN}${POST_KERNEL_RELEASE}${NC} | Patch ${GREEN}${POST_KERNEL_PATCH}${NC}"
        echo -e "  Compile Time      : $POST_COMPILE_TIME"
        echo -e "  Processes Online   : ${WP_GREEN}/${WP_TOTAL} GREEN"
        echo -e "  Backup Location    : $TAR_FILE"
        echo ""
        echo -e "${GREEN}========================================================================${NC}"
        echo ""

        # Check dev_w0 for any DB connect errors
        set +e
        DB_ERRORS=$(grep -c "ERROR.*db_connect" /usr/sap/"$SID"/D"$LOCAL_INST"/work/dev_w0 2>/dev/null)
        set -e

        if [ "$DB_ERRORS" -gt 0 ]; then
            echo -e "${YELLOW}WARNING: $DB_ERRORS DB connect errors detected in dev_w0. Check SAP system health.${NC}"
        fi
    fi
fi

# ------------------------------------------------------------------------------
# Step 12: Automatic Rollback (If Triggered)
# ------------------------------------------------------------------------------
if [ "$ROLLBACK_TRIGGERED" -eq 1 ]; then
    echo ""
    echo -e "${RED}========================================================================${NC}"
    echo -e "${RED}        UPGRADE FAILED — INITIATING AUTOMATIC ROLLBACK                  ${NC}"
    echo -e "${RED}========================================================================${NC}"
    echo ""

    if [ ! -f "$TAR_FILE" ]; then
        echo -e "${RED}CRITICAL: Backup archive $TAR_FILE not found! Manual recovery required!${NC}"
        echo -e "${RED}Contact SAP Basis team immediately.${NC}"
        exit 99
    fi

    # Verify backup integrity before restoring
    echo "Validating backup archive integrity..."
    tar -tzf "$TAR_FILE" > /dev/null 2>&1 || {
        echo -e "${RED}CRITICAL: Backup archive is CORRUPT! Manual recovery required!${NC}"
        exit 99
    }
    echo -e "${GREEN}Backup archive integrity verified.${NC}"

    # Stop any partially started instances
    echo "Stopping any running SAP processes..."
    for entry in "${APP_INSTANCES[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        sapcontrol -host "$host" -nr "$nr" -function Stop > /dev/null 2>&1 || true
    done
    for entry in "${CS_INSTANCES[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        sapcontrol -host "$host" -nr "$nr" -function Stop > /dev/null 2>&1 || true
    done

    sleep 15

    # Stop sapstartsrv
    for entry in "${ALL_INSTS[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        sapcontrol -nr "$nr" -function StopService > /dev/null 2>&1 || true
    done
    sleep 5

    # Kill any remaining SAP processes
    pkill -u "$SIDADM" -f sapstartsrv 2>/dev/null || true
    sleep 3

    # IPC cleanup
    for entry in "${ALL_INSTS[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        cleanipc "$nr" remove > /dev/null 2>&1 || true
    done

    # Restore kernel from backup
    echo "Restoring kernel from backup: $TAR_FILE"
    echo "Target: $KERNEL_DIR"

    # Clear current kernel directory and restore
    rm -rf "${KERNEL_DIR:?}"/*
    tar -xzf "$TAR_FILE" -C "$KERNEL_DIR"/ || {
        echo -e "${RED}CRITICAL: Restore from backup FAILED! Kernel directory is empty!${NC}"
        echo -e "${RED}Manual restore required from: $TAR_FILE${NC}"
        exit 99
    }

    # Fix ownership and permissions after restore
    chown -R "$SIDADM":sapsys "$KERNEL_DIR"/*
    chmod 755 "$KERNEL_DIR"/disp+work
    chmod 755 "$KERNEL_DIR"/sapstartsrv
    chmod 755 "$KERNEL_DIR"/sapstart

    echo -e "${GREEN}Kernel files restored from backup.${NC}"

    # ------------------------------------------------------------------------------
    # Step 13: Post-Rollback Validation
    # ------------------------------------------------------------------------------
    echo -e "${CYAN}--- Step 13: Post-Rollback Validation ---${NC}"

    # Verify restored kernel version matches original
    set +e
    RESTORED_VERSION_OUTPUT=$("$KERNEL_DIR/disp+work" -V 2>&1)
    set -e

    RESTORED_RELEASE=$(echo "$RESTORED_VERSION_OUTPUT" | grep -i "kernel release" | head -1 | awk '{print $NF}')
    RESTORED_PATCH=$(echo "$RESTORED_VERSION_OUTPUT" | grep -i "patch number" | head -1 | awk '{print $NF}')

    ROLLBACK_VALID=0
    if [ "$RESTORED_RELEASE" = "$OLD_KERNEL_RELEASE" ] && [ "$RESTORED_PATCH" = "$OLD_KERNEL_PATCH" ]; then
        ROLLBACK_VALID=1
    fi

    # Restart sapstartsrv with restored kernel
    echo "Starting sapstartsrv with restored kernel..."
    for entry in "${ALL_INSTS[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        TARGET_HOST=$(echo "$host" | cut -d'.' -f1 | tr '[:upper:]' '[:lower:]')

        if [[ "$TARGET_HOST" == "$LOCAL_HOST" ]] || [[ "$TARGET_HOST" == "localhost" ]]; then
            INST_PROFILE=$(ls /usr/sap/"$SID"/SYS/profile/"${SID}"_*"${nr}"_* 2>/dev/null | head -1)
            if [ -n "$INST_PROFILE" ]; then
                "$KERNEL_DIR"/sapstartsrv pf="$INST_PROFILE" -D -u "$SIDADM"
                sleep 5
            fi
        fi
    done

    # Start Central Services first, then App Servers
    echo "Starting SAP system with restored kernel..."
    for entry in "${CS_INSTANCES[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        set +e
        sapcontrol -host "$host" -nr "$nr" -function Start
        sapcontrol -host "$host" -nr "$nr" -function WaitforStarted 300 10
        set -e
    done

    for entry in "${APP_INSTANCES[@]}"; do
        IFS=':' read -r nr host feat <<< "$entry"
        set +e
        sapcontrol -host "$host" -nr "$nr" -function Start
        sapcontrol -host "$host" -nr "$nr" -function WaitforStarted 600 10
        set -e
    done

    sleep 10

    # Final rollback status check
    set +e
    RB_WP_CHECK=$(sapcontrol -nr "$LOCAL_INST" -function GetProcessList 2>&1)
    RB_WP_GREEN=$(echo "$RB_WP_CHECK" | grep -c "GREEN")
    RB_WP_TOTAL=$(echo "$RB_WP_CHECK" | grep -cE "GREEN|YELLOW|RED|GRAY")
    set -e

    echo ""
    if [ "$ROLLBACK_VALID" -eq 1 ] && [ "$RB_WP_GREEN" -gt 0 ]; then
        echo -e "${GREEN}========================================================================${NC}"
        echo -e "${GREEN}            ROLLBACK COMPLETED SUCCESSFULLY                             ${NC}"
        echo -e "${GREEN}========================================================================${NC}"
        echo ""
        echo -e "  System SID         : $SID"
        echo -e "  Restored Kernel    : Release ${GREEN}${RESTORED_RELEASE}${NC} | Patch ${GREEN}${RESTORED_PATCH}${NC}"
        echo -e "  Original Kernel    : Release ${OLD_KERNEL_RELEASE} | Patch ${OLD_KERNEL_PATCH}"
        echo -e "  Version Match      : ${GREEN}YES${NC}"
        echo -e "  Processes Online   : ${RB_WP_GREEN}/${RB_WP_TOTAL} GREEN"
        echo ""
        echo -e "${GREEN}========================================================================${NC}"
    else
        echo -e "${RED}========================================================================${NC}"
        echo -e "${RED}            ROLLBACK VALIDATION FAILED                                  ${NC}"
        echo -e "${RED}========================================================================${NC}"
        echo ""
        echo -e "  Restored Release   : $RESTORED_RELEASE (Expected: $OLD_KERNEL_RELEASE)"
        echo -e "  Restored Patch     : $RESTORED_PATCH (Expected: $OLD_KERNEL_PATCH)"
        echo -e "  Processes Online   : ${RB_WP_GREEN}/${RB_WP_TOTAL}"
        echo -e "  Backup Location    : $TAR_FILE"
        echo ""
        echo -e "${RED}  MANUAL INVESTIGATION REQUIRED. Check:${NC}"
        echo -e "${RED}    - /usr/sap/$SID/D${LOCAL_INST}/work/dev_w0${NC}"
        echo -e "${RED}    - /usr/sap/$SID/D${LOCAL_INST}/work/dev_disp${NC}"
        echo -e "${RED}========================================================================${NC}"
        exit 1
    fi
fi

# ------------------------------------------------------------------------------
# Step 14: Retention Policy (Keep N and N-1)
# ------------------------------------------------------------------------------
echo -e "${CYAN}--- Step 14: Applying Backup Retention Policy ---${NC}"

cd "$BASE_DIR" || {
    echo -e "${RED}ERROR: Failed to enter $BASE_DIR during cleanup.${NC}"
    exit 1
}

PURGE_COUNT=0
ls -td run_* 2>/dev/null | tail -n +3 | while read -r old_run; do
    if [ -d "$old_run" ]; then
        echo "Purging old run: $BASE_DIR/$old_run"
        rm -rf "${BASE_DIR:?}/${old_run}"
        PURGE_COUNT=$((PURGE_COUNT + 1))
    fi
done

echo -e "${GREEN}Retention policy applied. Kept latest 2 runs.${NC}"

echo ""
echo -e "${GREEN}========================================================================${NC}"
echo -e "${GREEN}   SAP Kernel Maintenance Script Execution Complete                     ${NC}"
echo -e "${GREEN}                                                                        ${NC}"
echo -e "${GREEN}   Developed and maintained by : Subham Dubey                           ${NC}"
echo -e "${GREEN}   For issues or feedback      : Contact Subham Dubey                   ${NC}"
echo -e "${GREEN}========================================================================${NC}"
echo ""
